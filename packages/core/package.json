{
  "name": "@timps/parasol-core",
  "version": "0.1.0",
  "description": "Shared foundation types, constants, errors and utilities for TIMPS-Parasol",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./src/types/index.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./src/constants/index.ts"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "types": "./src/errors/index.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandeeprdy1729/timps-parasol.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Sandeeprdy1729/timps-parasol#readme",
  "bugs": {
    "url": "https://github.com/Sandeeprdy1729/timps-parasol/issues"
  },
  "author": "Sandeep Reddy (TIMPS) <https://timps-website.vercel.app/>"
}